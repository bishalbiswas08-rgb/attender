# ==========================================================
# ATTENDER - Environment Variables Configuration
# "Smart attendance. Zero hassle."
# ==========================================================

# Supabase Public Configuration (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase Server-Only Secret (Never exposed to browser)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Google Gemini API Key (Server-only for AI classroom recognition & ATTENDER AI)
GEMINI_API_KEY=your-gemini-api-key

# Attendance Threshold Percentage (Default 75%)
NEXT_PUBLIC_ATTENDANCE_THRESHOLD=75
